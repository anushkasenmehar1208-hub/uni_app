:{$PORT} {
    @legacy_favicon path /favicon.ico
    redir @legacy_favicon /brand-favicon-20260306.ico 308

    # Reflex backend expects websocket endpoint at /_event/ (with trailing slash).
    handle /_event {
        rewrite * /_event/
        reverse_proxy 127.0.0.1:8000
    }

    handle /_event/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /_upload* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /_health {
        reverse_proxy 127.0.0.1:8000
    }

    handle /_all_routes {
        reverse_proxy 127.0.0.1:8000
    }

    handle /ping {
        reverse_proxy 127.0.0.1:8000
    }

    handle /auth-codespace {
        reverse_proxy 127.0.0.1:8000
    }

    handle /auth/google/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /health {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3002
    }
}
