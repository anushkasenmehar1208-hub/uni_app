:{$PORT} {
    @legacy_favicon path /favicon.ico
    redir @legacy_favicon /brand-favicon-20260306.ico 308

    # Keep backend routes ahead of frontend fallback.
    route {
        # Reflex backend expects websocket endpoint at /_event/ (with trailing slash).
        @event_no_slash path /_event
        rewrite @event_no_slash /_event/

        @backend path /_event* /_upload* /_health /_all_routes /ping /auth-codespace /auth/google/* /api/* /health
        reverse_proxy @backend 127.0.0.1:8000 {
            transport http {
                versions h1
            }
        }

        reverse_proxy 127.0.0.1:3001
    }
}
